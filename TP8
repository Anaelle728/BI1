def statistique_lettre(chemin):
    fichier = open( chemin , 'r', encoding = 'utf-8' )
    d=dict()
    for lignes in fichier:
        for lettre in lignes:
            if lettre !='\n':
                if lettre in d:
                    d[lettre]=d[lettre]+1
                else:
                    d[lettre]=1
    fichier.close()
                        
    return d

