def ensemble_de_lettres(chemin):
    fichier = open( chemin , 'r', encoding = 'utf-8' )
    e=set()
    for lignes in fichier:
        for lettre in lignes:
            if lettre !='\n':
                e.add(lettre)
    fichier.close()
    
    return e

