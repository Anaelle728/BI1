#!/usr/bin/python3
import tkinter as tk
from math import *


(Hauteur,Largeur) = (500,500)
root = tk.Tk()
root.title("Balle rebondissante")
Dessin = tk.Canvas(root,height=Hauteur,width=Largeur,bg='white')
Dessin.pack()

def disque(x,y,r,couleur):
    p = (x+r,y+r)
    q = (x-r,y-r)
    Dessin.create_oval(p,q,fill=couleur)


def ballon(x,y,r):
    p=(x-r,y-r) ; p1=(x-2.5*r,y-r) ; p2=(x+2.5*r,y-r)
    q=(x+r,y+r) ; q1=(x-.5*r, y+r) ; q2=x+.5*r, y+r
    Dessin.create_oval(p,q,fill='orange',outline='black',width=5)
    Dessin.create_line((x,y-r),(x,y+r),width=5)
    Dessin.create_arc(p1,q1, extent=80, start=-40, width=5,style='arc')
    Dessin.create_arc(p2,q2, extent=80, start=140, width=5,style='arc')
    
class État():
    
    
    def __init__(self):
        
        self.x=(Largeur//2)
        self.y=(Hauteur//2)
        self.xv=5
        self.yv=2
        self.r=40
        self.temps=0
        self.affichage()
        
        
    def affichage(self):
        Dessin.delete('all')
        ballon(self.x,self.y,self.r)
        self.x += self.xv
        self.y += self.yv
        if self.x >= Largeur:
            self.xv = -self.xv
        if self.y>= Hauteur:
            self.yv= -self.yv
        if self.x <= 0:
            self.xv = -self.xv
        if self.y<=0:
            self.yv= -self.yv
        
            
            
        
        
        
        
        
def tictac():
    état.temps = état.temps+1
    état.affichage()
    Dessin.after(10,tictac)
    
    
    
    
    
état=État()
tictac() 
root.mainloop()

   
