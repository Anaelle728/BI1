def ératoshène(n):
    L=[True]*n
    for i in range(n):
        if i == 0 or i == 1:
            L[i] = False
        if L[i]== True:
            for k in range(2 ,int(n**1/2)):
                if i*k<n:
                    L[i*k] = False
    return L

