def maj_inventaire(stock,produit,n):
    for i in range(len(stock)):
        nom , quantite = stock[i]
        if nom == produit:
            stock[i]= (nom ,quantite - n)
        
    return stock

assert maj_inventaire(stock,'Pommes',3) == [('Pommes', 7), ('Carottes', 5), ('Radis', 23), ('Lentilles', 534), ('Poivrons', 12)]

