def ajoute_horizontal(M1,M2):
    n,m1=dimensions(M1)
    n2,m2= dimensions(M2)
    assert(n==n2)
    m3=m1+m2
    B = nouvelle_matrice(n,m3)
    for i in range(m1):
        for j in range(m2):
            B[i][j] = M1[i][j] 
            B[i][j] = M2[i][j]
    return B

    M = fichier_vers_matrice('space-invader-pieuvre.pbm')
