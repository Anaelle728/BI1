    B = nouvelle_matrice(n,m)
    for i in range(n): #lignes 
        for j in range(m):# colones 
            if M[i][j]== True:
                print(pleins , end='')
                B[i][j] = pleins
            else :
                print(vide , end='')
                B[i][j] = vide
        print('')                        
    return B


